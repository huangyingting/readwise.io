{
  "name": "readwise-reader-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-prisma.mjs && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node scripts/prepare-prisma.mjs && prisma db push && prisma generate",
    "db:seed": "node prisma/seed.mjs",
    "db:setup": "npm run db:push && npm run db:seed",
    "bootstrap:admin": "npx tsx scripts/bootstrap-admin.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  }
}
